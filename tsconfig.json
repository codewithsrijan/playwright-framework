{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "playwright-report",
    "test-results",
    // manual3Auth.ts is missing from this directory — pre-existing broken import.
    // Excluded until the file is restored or the imports are fixed.
    "tests/ucm-manual3-aws"
  ]
}
